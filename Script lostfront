    local function CheckLeaderboard(plrName)
        local lb = PlayerGui:FindFirstChild("leaderboard")
        if not lb then return nil end
        local defenders = lb:FindFirstChild("defenders", true)
        local attackers = lb:FindFirstChild("attackers", true)
        local function IsInTeam(teamFrame)
            if not teamFrame then return false end
            for _, v in ipairs(teamFrame:GetDescendants()) do
                if v:IsA("TextLabel") and v.Text == plrName then return true end
            end
            return false
        end
        if IsInTeam(defenders) then return "defenders" end
        if IsInTeam(attackers) then return "attackers" end
        return nil
    end

    local function IsTeammate(plr)
        if plr == LocalPlayer then return true end
        local myTeam = CheckLeaderboard(LocalPlayer.Name)
        if myTeam then
            local plrTeam = CheckLeaderboard(plr.Name)
            if myTeam == plrTeam then return true
            elseif plrTeam ~= nil and myTeam ~= plrTeam then return false end
        end
        local char = plr.Character
        if char and char:FindFirstChild("Head") then
            for _, gui in ipairs(PlayerGui:GetDescendants()) do
                if gui:IsA("BillboardGui") and gui.Adornee == char.Head then
                    for _, desc in ipairs(gui:GetDescendants()) do
                        if desc:IsA("TextLabel") then
                            local c = desc.TextColor3
                            if c.G > 0.8 and c.R < 0.8 and c.B < 0.8 then return true end
                        end
                    end
                end
            end
        end
        return false
    end

