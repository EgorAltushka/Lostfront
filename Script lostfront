            Camera.FieldOfView = _G.PidorasSettings.TargetFOV 
        end
    end)

    -- ==========================================
    -- ОСНОВНОЙ ЦИКЛ ОТРИСОВКИ HEALTHBAR
    -- ==========================================
    RunService:BindToRenderStep("PidorasHubRender", Enum.RenderPriority.Camera.Value, function()
        for player, objects in pairs(ESP_Objects) do
            local char = player.Character
            local isTeammate = IsTeammate(player)
            
            if char and not isTeammate and _G.PidorasSettings.HealthBarEnabled then
                local humanoid = char:FindFirstChild("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                if humanoid and hrp and humanoid.Health > 0 then
                    local offsetPos = (hrp.CFrame * CFrame.new(-1.2, 0, 0)).Position
                    local screenPos, onScreen = Camera:WorldToViewportPoint(offsetPos)
                    
                    if onScreen and screenPos.Z > 0 then
                        objects.Health.Visible = true
                        local hpPerc = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        objects.Health.Size = Vector2.new(4, 25)
                        objects.Health.Position = Vector2.new(screenPos.X - 2, screenPos.Y - 12.5)
                        objects.Health.Color = Color3.fromRGB(255 * (1 - hpPerc), 255 * hpPerc, 0)
                    else
                        objects.Health.Visible = false
                    end
                else
                    objects.Health.Visible = false
                end
            else
                objects.Health.Visible = false
            end
        end
    end)

    MinimizeBtn.MouseButton1Click:Connect(function() 
        MainFrame.Visible = false
        Watermark.Visible = true
    end)
    
    Watermark.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            Watermark.Visible = false
            MainFrame.Visible = true
        end 
    end)
    
    CloseBtn.MouseButton1Click:Connect(function() 
        _G.PidorasSettings.ChamsEnabled = false; _G.PidorasSettings.NameESPEnabled = false; _G.PidorasSettings.HealthBarEnabled = false
        _G.PidorasSettings.FullbrightEnabled = false; _G.PidorasSettings.OptimizerEnabled = false
        
        ClearHighlights()
        ClearNameESPs()
        ToggleFullbright(false)
        ToggleOptimizer(false)
        Camera.FieldOfView = 70
        
        for _, obj in pairs(ESP_Objects) do for _, v in pairs(obj) do v:Remove() end end
        ScreenGui:Destroy()
        _G.PidorasSettings = nil 
    end)
end

main()
