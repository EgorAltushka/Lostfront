    -- ESP И ВИЗУАЛ
    -- ==========================================
    function ClearHighlights() for p, h in pairs(activeHighlights) do if h then h:Destroy() end activeHighlights[p] = nil end end
    function ClearNameESPs() for p, g in pairs(activeNameESPs) do if g then g:Destroy() end activeNameESPs[p] = nil end end

    function StartChams() 
        task.spawn(function() 
            while _G.PidorasSettings.ChamsEnabled do 
                for _, plr in ipairs(Players:GetPlayers()) do 
                    if not IsTeammate(plr) and plr.Character then 
                        if not activeHighlights[plr] or activeHighlights[plr].Parent ~= plr.Character then 
                            if activeHighlights[plr] then activeHighlights[plr]:Destroy() end 
                            local hl = Instance.new("Highlight")
                            hl.FillColor = Color3.fromRGB(255, 0, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.5
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = plr.Character
                            activeHighlights[plr] = hl 
                        end 
                    elseif IsTeammate(plr) and activeHighlights[plr] then
                        activeHighlights[plr]:Destroy()
                        activeHighlights[plr] = nil
                    end 
                end 
                task.wait(1) 
            end 
        end) 
    end

    function StartNameESP() 
        task.spawn(function() 
            while _G.PidorasSettings.NameESPEnabled do 
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                for _, plr in ipairs(Players:GetPlayers()) do 
                    if not IsTeammate(plr) and plr.Character and myRoot then 
                        local head = plr.Character:FindFirstChild("Head")
                        local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        if head and targetRoot then 
                            local dist = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
                            if not activeNameESPs[plr] or activeNameESPs[plr].Parent ~= head then 
                                if activeNameESPs[plr] then activeNameESPs[plr]:Destroy() end 
                                local bb = Instance.new("BillboardGui")
                                bb.Size = UDim2.new(0, 120, 0, 25)
                                bb.StudsOffset = Vector3.new(0, 2.5, 0)
                                bb.AlwaysOnTop = true
                                bb.Parent = head
                                local txt = Instance.new("TextLabel")
                                txt.Size = UDim2.new(1, 0, 1, 0)
                                txt.BackgroundTransparency = 1
                                txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                                txt.TextStrokeTransparency = 0
                                txt.Font = Enum.Font.GothamBold
                                txt.TextSize = 14
                                txt.Parent = bb
                                activeNameESPs[plr] = bb 
                            end
                            local txt = activeNameESPs[plr]:FindFirstChild("TextLabel")
                            if txt then txt.Text = plr.Name .. " [" .. dist .. "m]" end 
                        end 
                    elseif IsTeammate(plr) and activeNameESPs[plr] then
                        activeNameESPs[plr]:Destroy()
                        activeNameESPs[plr] = nil
                    end
                end 
                task.wait(0.5) 
            end 
        end) 
    end

    local function CreateESP(player)
        if player == LocalPlayer then return end
        local Health = Drawing.new("Square"); Health.Thickness = 1; Health.Filled = true; Health.Color = Color3.fromRGB(0, 255, 0); Health.Visible = false
        ESP_Objects[player] = {Health = Health}
    end
    local function RemoveESP(player)
        if ESP_Objects[player] then
            for _, obj in pairs(ESP_Objects[player]) do obj:Remove() end
            ESP_Objects[player] = nil
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
    Players.PlayerAdded:Connect(CreateESP)
    Players.PlayerRemoving:Connect(RemoveESP)

